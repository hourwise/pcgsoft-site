{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcgsoft.co.uk/docs/ai-discovery/observation-schema.json",
  "title": "PCGsoft discovery observation",
  "type": "object",
  "required": ["runId", "queryId", "queryText", "system", "modelOrVersion", "locale", "mentioned", "canonicalCitation", "githubEvidence", "entityAccuracy", "projectDiscovery", "privateMaterialExposed", "notes"],
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "queryId": { "type": "string", "pattern": "^Q[0-9]{2}$" },
    "queryText": { "type": "string", "minLength": 1 },
    "system": { "type": "string", "minLength": 1 },
    "modelOrVersion": { "type": ["string", "null"] },
    "locale": { "type": "string", "minLength": 2 },
    "mentioned": { "$ref": "#/$defs/observationValue" },
    "canonicalCitation": { "$ref": "#/$defs/observationValue" },
    "githubEvidence": { "$ref": "#/$defs/observationValue" },
    "entityAccuracy": { "$ref": "#/$defs/observationValue" },
    "projectDiscovery": { "$ref": "#/$defs/observationValue" },
    "privateMaterialExposed": { "$ref": "#/$defs/observationValue" },
    "position": { "type": ["integer", "null"], "minimum": 1 },
    "competingProjects": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },
    "evidenceReference": { "type": ["string", "null"] }
  },
  "$defs": {
    "observationValue": {
      "type": "string",
      "enum": ["OBSERVED", "NOT_OBSERVED", "UNKNOWN"]
    }
  }
}
