{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCGsoft meaningful portfolio activity",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "projectId", "date", "note"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "STATUS_CHANGED",
        "RELEASE_PUBLISHED",
        "PUBLIC_PREVIEW_AVAILABLE",
        "LIVE_SURFACE_AVAILABLE",
        "MILESTONE_NOTE",
        "PROJECT_COMPLETED"
      ]
    },
    "projectId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "note": { "type": "string", "maxLength": 500 }
  }
}
